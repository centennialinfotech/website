            border: none;
            padding: 12px 0;
            font-size: 24px; 
            color: #333;
            text-transform: capitalize;
            cursor: pointer;
            display: block;
            width: 100%;
            text-align: left; /* Align text to the left like a list */
            transition: all 0.3s ease;
            outline: none;
          }

          /* Active tab styling - changes color and weight */
